# ------------------------------------------------------------------
# CHAOS RACE — variáveis de ambiente do BACKEND (Node.js)
# Copie para backend/.env (ou .env na raiz) e ajuste. Nunca comite segredos.
# ------------------------------------------------------------------

# Porta HTTP. O Render injeta PORT automaticamente; localmente usamos 3001.
PORT=3001

# Origens autorizadas no CORS (separadas por vírgula).
# Em produção use exatamente a origem do frontend, por exemplo:
#   CORS_ORIGINS=https://seu-usuario.github.io
# Para testar em qualquer origem (apenas desenvolvimento): CORS_ORIGINS=*
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limite de salas simultâneas no processo.
MAX_ROOMS=40

# debug | info | warn | error
LOG_LEVEL=info

# production | development
NODE_ENV=development
